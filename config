# shellcheck source=auto/rust
. $ngx_addon_dir/auto/rust

ngx_addon_name=ngx_http_not_modified_filter_module_rs

if [ $HTTP = YES ]; then
    ngx_module_type=HTTP_FILTER
    ngx_module_incs=
    ngx_module_deps=
    # auto/module only consults ngx_module_order for dynamic modules, so there
    # is no way to order a statically linked filter ahead of nginx's own
    # not_modified filter. Built in statically, this module always runs after
    # it and sees a response that has already been answered. Load it as a
    # dynamic module to exercise its own logic - see the README.
    ngx_module_order=

    ngx_rust_target_type=LIB
    ngx_rust_target_features=

    ngx_module_name=ngx_http_not_modified_filter_rs_module
    ngx_module_libs=
    ngx_rust_target_name=ngx_http_not_modified_filter_module

    ngx_rust_module
fi
